opam-version: "2.0"
maintainer: "Windocotber@sjtu.edu.cn"
homepage: "https://github.com/WindOctober/FormalSQL"
dev-repo: "git+https://github.com/WindOctober/FormalSQL.git"
bug-reports: "https://github.com/WindOctober/FormalSQL/issues"
authors: ["Véronique Benzaken <veronique.benzaken@universite-paris-saclay.fr>"
          "Évelyne Contejean <evelyne.contejean@universite-paris-saclay.fr>"
          "Jingyu Ke <Windocotber@sjtu.edu.cn>"
]
license: ["MIT" "LGPL-3.0-only"]
build: [
  [make "-j%{jobs}%"]
]
install: [
  [make "install"]
]
depends: [
  "rocq-core" {>= "9.2.0" & < "9.3~"}
  "rocq-stdlib" {>= "9.1.0" & < "9.2~"}
  "coq-flocq" {>= "4.2.2"}
  "zarith" {>= "1.14"}
]
tags: [
  "category:Miscellaneous/Coq Extensions"
  "keyword:databases"
  "keyword:queries"
  "keyword:relational"
  "keyword:compiler"
  "logpath:SQLFormalSemantics"
]
synopsis: "A Coq mechanized executable formal semantics for realistic SQL queries"
description: """
FormalSQL is a Rocq library for executable, compositional semantics of a
PostgreSQL-oriented SQL fragment. It combines FormalData foundations with a
new exact ordered-outcome query and value semantics.
"""
url {
  src: "git+https://github.com/WindOctober/FormalSQL.git"
}
