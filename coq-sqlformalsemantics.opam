opam-version: "2.0"
maintainer: "Chantal.Keller@lri.fr"
homepage: "https://framagit.org/formaldata/sqlformalsemantics"
dev-repo: "git+https://framagit.org/formaldata/sqlformalsemantics.git"
bug-reports: "https://framagit.org/formaldata/sqlformalsemantics/-/issues"
authors: ["Véronique Benzaken <veronique.benzaken@universite-paris-saclay.fr>"
          "Évelyne Contejean <evelyne.contejean@universite-paris-saclay.fr>"
]
license: "Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International Public License"
build: [
  [cd src; make "-j%{jobs}%"]
]
install: [
  [cd src; make "install"]
]
depends: [
  "coq" {= "8.11.2"}
]
tags: [
  "category:Miscellaneous/Coq Extensions"
  "keyword:databases"
  "keyword:queries"
  "keyword:relational"
  "keyword:compiler"
  "logpath:SQLFormalSemantics"
]
synopsis: "A Coq mechanized executable formal semantics for realistic SQL queries"
description: """
SQLFormalSemantics is a Coq mechanized executable formal semantics for realistic SQL queries
"""
url {
  src: "git+https://framagit.org/formaldata/sqlformalsemantics.git"
}
